{
	"compatibility_date": "2026-03-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "about-naosuke884",
	// カスタムドメイン。デプロイ時にDNSレコードと証明書が自動設定される
	"routes": [{ "pattern": "hayashi-naoki.com", "custom_domain": true }],
	// 旧workers.devドメインは重複コンテンツ防止のため無効化する
	"workers_dev": false,
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
