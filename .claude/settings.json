{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "startup",
				"hooks": [
					{
						"type": "command",
						"command": "bash .claude/scripts/dev-server.sh",
						"timeout": 10,
						"statusMessage": "Starting Astro dev server in background..."
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash .claude/scripts/check-dev-log.sh",
						"timeout": 10,
						"statusMessage": "Checking dev server log for errors..."
					}
				]
			}
		]
	}
}
