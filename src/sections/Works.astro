---
import Section from "../components/section/Section.astro";

const works = [
	{
		title: "about-naosuke884",
		description: "自己紹介サイト。",
	},
];
---

<Section id="works" title="作ったもの" divider>
	<div class="grid gap-6">
		{works.map((work) => (
			<div class="card w-full max-w-md bg-primary text-primary-content">
				<div class="card-body">
					<h3 class="card-title text-subheading text-primary-content">{work.title}</h3>
					<p class="text-body text-primary-content/80">{work.description}</p>
				</div>
			</div>
		))}
	</div>
</Section>
