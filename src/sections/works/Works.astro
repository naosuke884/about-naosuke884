---
import Section from "../../components/Section.astro";
import GitHubIcon from "../../components/social-links/github.svg";
import { works } from "./data";
---

<Section id="works" title="作ったもの">
	<div class="grid gap-6">
		{works.map((work) => (
			<button
				type="button"
				class="work-card card relative w-full max-w-md bg-primary text-primary-content text-left cursor-pointer overflow-hidden"
				data-work-modal-trigger={work.id}
				aria-haspopup="dialog"
			>
				<div class="card-body grid grid-cols-[auto_1fr] gap-x-4">
					<img
						src={work.icon}
						alt=""
						class="row-span-2 h-full w-20 object-contain"
						loading="lazy"
					/>
					<h3 class="card-title text-subheading text-primary-content pb-2 border-b border-primary-content/20">
						{work.title}
					</h3>
					<p class="text-body text-primary-content/80">{work.summary}</p>
				</div>
			</button>
		))}
	</div>
	{works.map((work) => (
		<dialog id={`work-modal-${work.id}`} class="modal">
			{/* モバイルは全画面表示(h-fullはfixed inset-0の.modalグリッドいっぱいに伸びる。
			    vh系単位はFirefox Androidのアドレスバー問題があるため使わない)、
			    sm以上はdaisyUIデフォルトの中央表示に戻す */}
			<div class="modal-box h-full w-full max-w-none rounded-none sm:h-auto sm:w-11/12 sm:max-w-2xl sm:rounded-box">
				<form method="dialog">
					<button
						class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
						aria-label="閉じる"
					>
						✕
					</button>
				</form>
				<h3 class="text-subheading">{work.title}</h3>
				{/* controlsは付けない。開いた瞬間のplay()と組み合わさると再生開始時に
				    コントロールオーバーレイが出て数秒で消え、不安定に見えるため、
				    modal.tsでタップ/キー操作時に初めて表示する (#52) */}
				{/* 角丸はvideo自体でなくラッパーに付ける。videoのborder-radiusでは
				    ネイティブコントロールのオーバーレイがクリップされず角がずれるため、
				    overflow-hiddenでコントロールごと切り抜く */}
				<div class="mt-4 rounded-box border border-base-content/10 overflow-hidden">
					<video
						src={work.demo.src}
						aria-label={work.demo.label}
						muted
						loop
						playsinline
						preload="metadata"
						tabindex="0"
						class="block w-full"
					/>
				</div>
				<p class="pt-12 pb-4 text-body whitespace-pre-line">{work.description}</p>
				<div class="modal-action gap-4">
					{work.links.map((link) => (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-primary"
						>
							{link.icon === "github" && (
								<GitHubIcon class="size-5" fill="currentColor" aria-hidden="true" />
							)}
							{link.label}
						</a>
					))}
				</div>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button aria-label="閉じる">close</button>
			</form>
		</dialog>
	))}
</Section>

<script>
	import { setupWorksModal } from "./modal";
	setupWorksModal();
</script>

<style>
	/* ホバーでカード右下がめくれるドッグイヤー。
	   対角線の右下側はページ背景色(base-100)で「切り取られた角」、
	   左上側は折り返ったフラップを表現する。
	   ホバーできないデバイスでは発動しないため、めくれの切り口に合わせた
	   右下の角丸解除ごとhover:hoverに限定する */
	@media (hover: hover) {
		.work-card {
			border-bottom-right-radius: 0;
		}

		/* transformでスライドさせると::afterがアニメーション中だけコンポジタレイヤーに
		   昇格し、overflow-hiddenのクリップ縁がGPU側で再アンチエイリアスされて
		   カード下端に薄い線が見える環境があるため、レイヤー昇格しない
		   background-positionで同じスライドを行う */
		.work-card::after {
			content: "";
			position: absolute;
			right: 0;
			bottom: 0;
			width: 3.5rem;
			height: 3.5rem;
			background: linear-gradient(
					to top left,
					var(--color-base-100) 50%,
					color-mix(in oklab, var(--color-primary), white 25%) 50%
				)
				no-repeat;
			background-position: 3.5rem 3.5rem;
			transition: background-position 0.3s ease-out;
		}

		.work-card:hover::after,
		.work-card:focus-visible::after {
			background-position: 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.work-card::after {
			transition: none;
		}
	}
</style>
