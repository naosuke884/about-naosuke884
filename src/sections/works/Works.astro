---
import Section from "../../components/Section.astro";
import GitHubIcon from "../../components/social-links/github.svg";
import { works } from "./data";
---

<Section id="works" title="作ったもの">
	<div class="overflow-x-auto">
		<table class="table">
			<tbody>
				{works.map((work) => (
					<tr class="relative cursor-pointer transition-colors hover:bg-base-200 active:bg-base-200">
						<td class="whitespace-nowrap">
							{/* trをbuttonにはできないため、ボタンの::afterを行全体に広げて
							    クリック領域にするstretched buttonパターン(trがrelativeで基準) */}
							<button
								type="button"
								class="flex items-center gap-2 font-semibold cursor-pointer after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-primary focus-visible:after:-outline-offset-2"
								data-work-modal-trigger={work.id}
								aria-haspopup="dialog"
							>
								<img src={work.icon} alt="" class="size-6" loading="lazy" />
								{work.title}
							</button>
						</td>
						<td class="text-base-content/70">
							<span class="flex items-center justify-between gap-4">
								{work.summary}
								<span class="text-base-content/40" aria-hidden="true">›</span>
							</span>
						</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
	{works.map((work) => (
		<dialog id={`work-modal-${work.id}`} class="modal">
			{/* モバイルは全画面表示(h-fullはfixed inset-0の.modalグリッドいっぱいに伸びる。
			    vh系単位はFirefox Androidのアドレスバー問題があるため使わない)、
			    sm以上はdaisyUIデフォルトの中央表示に戻す */}
			<div class="modal-box h-full w-full max-w-none rounded-none sm:h-auto sm:w-11/12 sm:max-w-2xl sm:rounded-box">
				<form method="dialog">
					<button
						class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
						aria-label="閉じる"
					>
						✕
					</button>
				</form>
				<h3 class="text-subheading">{work.title}</h3>
				{/* controlsは付けない。開いた瞬間のplay()と組み合わさると再生開始時に
				    コントロールオーバーレイが出て数秒で消え、不安定に見えるため、
				    modal.tsでタップ/キー操作時に初めて表示する (#52) */}
				{/* 角丸はvideo自体でなくラッパーに付ける。videoのborder-radiusでは
				    ネイティブコントロールのオーバーレイがクリップされず角がずれるため、
				    overflow-hiddenでコントロールごと切り抜く */}
				<div class="mt-4 rounded-box border border-base-content/10 overflow-hidden">
					<video
						src={work.demo.src}
						aria-label={work.demo.label}
						muted
						loop
						playsinline
						preload="metadata"
						tabindex="0"
						class="block w-full"
					/>
				</div>
				<p class="pt-12 pb-4 text-body whitespace-pre-line">{work.description}</p>
				<div class="modal-action gap-4">
					{work.links.map((link) => (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="btn btn-primary"
						>
							{link.icon === "github" && (
								<GitHubIcon class="size-5" fill="currentColor" aria-hidden="true" />
							)}
							{link.label}
						</a>
					))}
				</div>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button aria-label="閉じる">close</button>
			</form>
		</dialog>
	))}
</Section>

<script>
	import { setupWorksModal } from "./modal";
	setupWorksModal();
</script>
