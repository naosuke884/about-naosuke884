---
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import { books } from "./data";
---

<Section id="books" title="読んだ本">
	<div
		slot="heading-extra"
		class="flex items-center gap-1.5"
		aria-hidden="true"
		data-books-dots
	>
		{books.map(() => (
			<span class="w-2 h-2 rounded-full bg-base-content/20 transition-colors" />
		))}
	</div>
	<div
		class="carousel carousel-start gap-6 px-1 -mx-1 pt-1 -mt-1 pb-4 w-full"
		data-books-carousel
	>
		{books.map((book) => (
			<a
				href={book.url}
				target="_blank"
				rel="noopener noreferrer"
				class="carousel-item w-32 group"
			>
				<Image
					src={book.cover}
					alt={book.title}
					width={128}
					height={176}
					densities={[1, 2]}
					class="w-32 h-44 object-cover rounded ring-1 ring-base-content/10 transition-shadow group-hover:ring-2 group-hover:ring-primary"
				/>
			</a>
		))}
	</div>
</Section>

<script>
	import { setupBooksCarouselDots } from "./carousel-dots";
	setupBooksCarouselDots();
</script>
