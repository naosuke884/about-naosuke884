---
import Tag from "../components/Tag.astro";

const badges = [
	"ソフトウェアエンジニア",
	"筋トレ",
	"League of Legends",
	"映画",
	"漫画",
	"海外ドラマ",
];
---

<section id="about" class="min-h-[calc(100dvh-var(--spacing-header))] bg-primary/18 flex items-center px-12 md:px-24">
	<div class="max-w-3xl mx-auto w-full">
		<h1 class="text-display mb-6">Hayashi Naoki</h1>

		<div class="chat chat-start mb-6">
			<div class="chat-image avatar">
				<div class="w-18 rounded-full">
					<img
						src="/my-icon.png"
						alt="naosuke884のアイコン"
						width="72"
						height="72"
					/>
				</div>
			</div>
			<p class="chat-bubble bg-base-100">
				なんもわからん
			</p>
		</div>

		<div class="flex flex-wrap gap-2">
			{badges.map((badge) => <Tag>{`# ${badge}`}</Tag>)}
		</div>
	</div>
</section>
