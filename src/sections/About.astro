---
const badges = ["💪 筋トレ", "🏠 インドア", "🔍 趣味募集中"];
---

<section id="about" class="min-h-screen flex items-center justify-center px-6">
	<div class="max-w-2xl text-center">
		<div class="mb-6">
			<img
				src="/my-icon.png"
				alt="naosuke884のアイコン"
				class="w-28 h-28 rounded-full mx-auto"
			/>
		</div>

		<h1 class="text-3xl font-bold mb-4">Hayashi Naoki</h1>

		<p class="text-lg text-on-base/70 mb-8 leading-relaxed tracking-wide pl-4">
			Webエンジニアです。<br />
			にわか卒業を目指してます。
		</p>

		<div class="flex flex-wrap justify-center gap-2">
			{badges.map((badge) => (
				<span class="px-3 py-1 rounded-full text-sm border border-accent/30 text-accent">
					{badge}
				</span>
			))}
		</div>
	</div>
</section>
