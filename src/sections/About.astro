---
import { Image } from "astro:assets";
import myIcon from "../assets/my-icon.png";
import SocialLinks from "../components/social-links/SocialLinks.astro";
import Tag from "../components/Tag.astro";

const badges = [
	"ソフトウェアエンジニア",
	"筋トレ",
	"League of Legends",
	"映画",
	"漫画",
	"海外ドラマ",
];
---

<section id="about" class="min-h-[min(calc(100dvh-var(--spacing-header)),640px)] bg-primary/20 flex items-center px-12 md:px-24">
	<div class="max-w-3xl mx-auto w-full">
		<h1 class="text-display mb-8">Hayashi Naoki</h1>

		<div class="chat chat-start mb-8">
			<div class="chat-image avatar">
				<div class="w-18 rounded-full">
					<Image
						src={myIcon}
						alt="naosuke884のアイコン"
						width={72}
						height={72}
						densities={[1, 2]}
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>
			<p class="chat-bubble bg-base-100">
				なんもわからん
			</p>
		</div>

		<div class="flex flex-wrap gap-2 mb-8">
			{badges.map((badge) => <Tag>{`# ${badge}`}</Tag>)}
		</div>

		<SocialLinks />
	</div>
</section>
