---
import { fetchLinkPreview } from "./link-preview";

interface Props {
	url: string;
}

const { url } = Astro.props;
const { hostname } = new URL(url);
const { title, description, siteName, image } = await fetchLinkPreview(url);
// 見出しが取れなければホスト名を見出しにし、下段はホスト名の重複を避けてURL全体を出す
const heading = title ?? siteName;
---

<!-- 記事で紹介している外部サイトのカード。記事本体が外部にあるように読めないよう、
     「で読む」ではなく紹介先であることをラベルで示す(issue #59)。
     OGPが取れなかった項目は出さず、ホスト名とURLだけのカードになる。
     カード内の全テキストが読み上げ名になると長すぎるため、aria-labelで見出しだけに絞る -->
<a
	href={url}
	target="_blank"
	rel="noopener noreferrer"
	aria-label={`紹介しているサイト: ${heading ?? hostname}(新しいタブで開く)`}
	class="card"
>
	{
		image && (
			<figure>
				<img
					src={image.src}
					width={image.width}
					height={image.height}
					alt=""
					loading="lazy"
					decoding="async"
				/>
			</figure>
		)
	}
	<div class="body">
		<span class="text-small">紹介しているサイト</span>
		<span class="text-body title">
			{heading ?? hostname}
		</span>
		{
			description && (
				<span class="text-small description">
					{description}
				</span>
			)
		}
		<span class="text-small url">
			{heading ? hostname : url} ↗
		</span>
	</div>
</a>

<style>
	/* 狭い画面では画像を上、本文を下に積み、sm以上で横に並べる */
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		margin-top: 1.5rem;
		overflow: hidden;
		border: 1px solid var(--color-base-300);
		border-radius: var(--radius-box);
		background-color: var(--color-base-200);
		outline: 2px solid transparent;
		outline-offset: 2px;
		transition: var(--transition-colors);

		@media (width >= 40rem) {
			flex-direction: row;
		}

		@media (hover: hover) {
			&:hover {
				border-color: var(--color-primary);
			}
		}

		&:focus-visible {
			outline-color: currentColor;
		}
	}

	figure {
		display: flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		overflow: hidden;

		@media (width >= 40rem) {
			width: 40%;
		}
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.body {
		display: flex;
		flex: auto;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
		padding: 1rem 1.25rem;
	}

	.title {
		font-weight: 500;
		color: var(--color-base-content);
	}

	.description {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.url {
		word-break: break-all;
	}
</style>
