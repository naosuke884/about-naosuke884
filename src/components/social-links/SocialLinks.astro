---
import GitHubIcon from "./github.svg";
import XIcon from "./x.svg";
---

<div class="flex gap-6">
	<a
		href="https://github.com/naosuke884"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="GitHub"
		class="p-2 -m-2 text-base-content/70 hover:text-base-content transition-colors"
	>
		<GitHubIcon class="size-6" fill="currentColor" aria-hidden="true" />
	</a>
	<a
		href="https://x.com/884naoki_dev"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="X"
		class="p-2 -m-2 text-base-content/70 hover:text-base-content transition-colors"
	>
		<XIcon class="size-6" fill="currentColor" aria-hidden="true" />
	</a>
</div>
