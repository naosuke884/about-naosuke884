---
import GitHubIcon from "./github.svg";
import MailIcon from "./mail.svg";
import XIcon from "./x.svg";
---

<div class="social-links">
	<a
		href="https://github.com/naosuke884"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="GitHub"
	>
		<GitHubIcon fill="currentColor" aria-hidden="true" />
	</a>
	<a
		href="https://x.com/884naoki_dev"
		target="_blank"
		rel="noopener noreferrer"
		aria-label="X"
	>
		<XIcon fill="currentColor" aria-hidden="true" />
	</a>
	<a
		href="mailto:884naoki.dev@gmail.com"
		aria-label="メール"
	>
		<MailIcon fill="currentColor" aria-hidden="true" />
	</a>
</div>

<style>
	.social-links {
		display: flex;
		gap: 1.5rem;
	}

	a {
		padding: 0.5rem;
		margin: -0.5rem;
		color: var(--color-muted);
		transition: var(--transition-colors);

		@media (hover: hover) {
			&:hover {
				color: var(--color-base-content);
			}
		}
	}

	a :global(svg) {
		width: 1.5rem;
		height: 1.5rem;
	}
</style>
