---
interface Props {
	id: string;
	title: string;
	divider?: boolean;
}

const { id, title, divider = false } = Astro.props;
---

<section
	id={id}
	class:list={[
		"py-24 px-12 md:px-24",
		divider && "border-t-2 border-dashed border-base-content/20",
	]}
>
	<div class="max-w-3xl mx-auto">
		<h2 class="text-heading mb-4">{title}</h2>
		<slot />
	</div>
</section>
