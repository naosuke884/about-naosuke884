---
import CheckIcon from "./check.svg";
import LinkIcon from "./link.svg";

interface Props {
	label: string;
	hash?: string;
}

const { label, hash } = Astro.props;

const tipClass =
	"pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 whitespace-nowrap rounded-field bg-neutral px-2 py-1 text-sm text-neutral-content opacity-0 transition-opacity";
---

<!-- アイコン色の/60は非テキストのコントラスト3:1(WCAG 1.4.11)をライトテーマのbase-200上でも満たす下限付近 -->
<div class="group relative">
	<button
		type="button"
		class="btn btn-ghost btn-xs btn-circle swap swap-rotate text-base-content/60 hover:text-base-content"
		data-copy-link={hash ?? ""}
		aria-label={label}
	>
		<LinkIcon class="swap-off size-4" aria-hidden="true" />
		<CheckIcon class="swap-on size-4" aria-hidden="true" />
	</button>
	<span
		class:list={[tipClass, "group-hover:opacity-100 group-active:opacity-0"]}
		data-copy-tip
		aria-hidden="true">リンクをコピー</span
	>
	<span class={tipClass} data-copied-tip aria-hidden="true">コピーしました</span>
	<span class="sr-only" role="status" data-copy-status></span>
</div>

<script>
	import { setupCopyLinkButtons } from "./copy-link";
	setupCopyLinkButtons();
</script>
