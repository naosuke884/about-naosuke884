---
import CheckIcon from "./check.svg";
import LinkIcon from "./link.svg";

interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;

const tipClass =
	"pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 whitespace-nowrap rounded-field bg-neutral px-2 py-1 text-sm text-neutral-content opacity-0 transition-opacity";
---

<section
	id={id}
	class="py-12 px-12 md:px-24"
>
	<div class="max-w-3xl mx-auto">
		<div class="mb-8 flex items-center justify-between">
			<div class="flex items-center gap-2">
				<h2 class="text-heading flex items-center gap-3">
					<span class="w-1 self-stretch rounded-full bg-primary" aria-hidden="true"
					></span>
					{title}
				</h2>
				<div class="group relative">
					<button
						type="button"
						class="btn btn-ghost btn-xs btn-circle swap swap-rotate text-base-content/40 hover:text-base-content"
						data-copy-link={id}
						aria-label={`${title}セクションへのリンクをコピー`}
					>
						<LinkIcon class="swap-off size-4" aria-hidden="true" />
						<CheckIcon class="swap-on size-4" aria-hidden="true" />
					</button>
					<span
						class:list={[
							tipClass,
							"group-hover:opacity-100 group-active:opacity-0",
						]}
						data-copy-tip
						aria-hidden="true">リンクをコピー</span
					>
					<span class={tipClass} data-copied-tip aria-hidden="true"
						>コピーしました</span
					>
					<span class="sr-only" role="status" data-copy-status></span>
				</div>
			</div>
			<slot name="heading-extra" />
		</div>
		<slot />
	</div>
</section>

<script>
	import { setupCopySectionLinks } from "./copy-link";
	setupCopySectionLinks();
</script>
