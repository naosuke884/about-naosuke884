---
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import { books } from "./data";
import MemoIcon from "./memo.svg";
---

<Section id="books" title="読んだ本">
	<div
		slot="heading-extra"
		class="flex items-center gap-1.5"
		aria-hidden="true"
		data-books-dots
	>
		{books.map(() => (
			<span class="w-2 h-2 rounded-full bg-base-content/20 transition-colors" />
		))}
	</div>
	<div
		class="carousel carousel-start gap-6 px-1 -mx-1 pt-1 -mt-1 pb-4 w-full"
		data-books-carousel
	>
		{books.map((book) => (
			<div class="carousel-item w-32 relative">
				<a
					href={book.url}
					target="_blank"
					rel="noopener noreferrer"
					class="relative block after:absolute after:inset-0 after:rounded after:bg-primary/18 after:opacity-0 after:transition-opacity hover:after:opacity-100"
				>
					<Image
						src={book.cover}
						alt={book.title}
						width={128}
						height={176}
						densities={[1, 2]}
						class="w-32 h-44 object-cover rounded"
					/>
				</a>
				{/* 表紙リンクの左下に重ねる扇形（四分円）ボタン。<a>の中にネストせず兄弟として重ねる。
				    クリック領域として目立つよう、弧側だけに縁取りを付ける */}
				<button
					type="button"
					class="absolute bottom-0 left-0 w-9 h-9 rounded-tr-full rounded-bl bg-primary text-primary-content border-t-2 border-r-2 border-neutral cursor-pointer flex items-end justify-start pl-1.5 pb-1.5 transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
					data-book-modal-trigger={book.id}
					aria-haspopup="dialog"
					aria-label={`「${book.title}」の感想メモ`}
				>
					<MemoIcon class="size-4" aria-hidden="true" />
				</button>
			</div>
		))}
	</div>
	{books.map((book) => (
		<dialog id={`book-modal-${book.id}`} class="modal">
			<div class="modal-box max-w-sm">
				<form method="dialog">
					<button
						class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
						aria-label="閉じる"
					>
						✕
					</button>
				</form>
				<h3 class="text-subheading text-center">{book.title}</h3>
				<p class="pt-4 text-body whitespace-pre-line">{book.memo}</p>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button aria-label="閉じる">close</button>
			</form>
		</dialog>
	))}
</Section>

<script>
	import { setupBooksCarouselDots } from "./carousel-dots";
	import { setupBooksModal } from "./modal";
	setupBooksCarouselDots();
	setupBooksModal();
</script>
