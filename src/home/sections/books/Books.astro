---
import { Image } from "astro:assets";
import Section from "../../components/Section.astro";
import { books } from "./data";
import MemoIcon from "./memo.svg";
---

<Section id="books" title="読んだ本">
	<div slot="heading-extra" class="dots" aria-hidden="true" data-books-dots>
		{books.map(() => <span />)}
	</div>
	<div class="carousel" data-books-carousel>
		{books.map((book) => (
			<div class="carousel-item">
				{/* 表紙全体を感想メモのモーダルを開くボタンにする。出版社ページへのリンクはモーダル内に置く */}
				<button
					type="button"
					class="cover"
					data-book-modal-trigger={book.id}
					aria-haspopup="dialog"
					aria-label={`「${book.title}」の感想メモ`}
				>
					<Image
						src={book.cover}
						alt=""
						width={128}
						height={176}
						densities={[1, 2]}
					/>
					{/* 感想メモがあることを示す左下の扇形（四分円）の目印。独立したボタンにはせず表紙ボタンの一部とし、
					    hoverのオーバーレイ(::after)より手前に出すためz-indexで重ねる */}
					<span class="memo-mark" aria-hidden="true">
						<MemoIcon />
					</span>
				</button>
			</div>
		))}
	</div>
	{books.map((book) => (
		<dialog
			id={`book-modal-${book.id}`}
			class="modal"
			aria-labelledby={`book-modal-${book.id}-title`}
		>
			<div class="modal-box">
				<form method="dialog">
					<button class="btn btn-sm btn-circle btn-ghost close" aria-label="閉じる">
						✕
					</button>
				</form>
				<h3 id={`book-modal-${book.id}-title`} class="text-subheading">
					{book.title}
				</h3>
				<p class="text-body memo">{book.memo}</p>
				<div class="modal-action">
					<a
						href={book.url}
						target="_blank"
						rel="noopener noreferrer"
						class="btn btn-primary publisher"
					>
						出版社のページを見る ↗
					</a>
				</div>
			</div>
			{/* モーダルの外側をクリックしたら閉じる */}
			<form method="dialog" class="modal-backdrop">
				<button aria-label="閉じる">close</button>
			</form>
		</dialog>
	))}
</Section>

<script>
	import { setupBooksCarouselDots } from "./carousel-dots";
	import { setupBooksModal } from "./modal";
	setupBooksCarouselDots();
	setupBooksModal();
</script>

<style>
	.dots {
		display: flex;
		align-items: center;
		gap: 0.375rem;

		&[data-hidden] {
			visibility: hidden;
		}

		& > span {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 9999px;
			background-color: color-mix(
				in oklab,
				var(--color-base-content) 20%,
				transparent
			);
			transition: var(--transition-colors);

			&[data-active] {
				background-color: var(--color-base-content);
			}
		}
	}

	/* 上下左右のpaddingは、フォーカスリングがスクロール領域で切れないようにする余白。
	   同じ分のネガティブマージンで位置を戻す */
	.carousel {
		display: inline-flex;
		gap: 1.5rem;
		width: 100%;
		padding: 0.25rem 0.25rem 1rem;
		margin: -0.25rem -0.25rem 0;
		overflow-x: scroll;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;

		@media (prefers-reduced-motion: no-preference) {
			scroll-behavior: smooth;
		}

		&::-webkit-scrollbar {
			display: none;
		}
	}

	.carousel-item {
		display: flex;
		flex: none;
		width: 8rem;
		scroll-snap-align: start;
	}

	.cover {
		position: relative;
		display: block;
		border-radius: 0.25rem;

		&::after {
			content: "";
			position: absolute;
			inset: 0;
			border-radius: 0.25rem;
			background-color: color-mix(in oklab, var(--color-primary) 18%, transparent);
			opacity: 0;
			transition: opacity 150ms cubic-bezier(0.4, 0, 0.2, 1);
		}

		@media (hover: hover) {
			&:hover::after {
				opacity: 1;
			}
		}

		&:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}

		& :global(img) {
			width: 8rem;
			height: 11rem;
			object-fit: cover;
			border-radius: 0.25rem;
		}
	}

	.memo-mark {
		position: absolute;
		z-index: 10;
		bottom: 0;
		left: 0;
		display: flex;
		align-items: flex-end;
		justify-content: flex-start;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0 0 0.375rem 0.375rem;
		border-radius: 0 9999px 0 0.25rem;
		background-color: var(--color-primary);
		color: var(--color-primary-content);

		& :global(svg) {
			width: 1rem;
			height: 1rem;
		}
	}

	/* 閉じている間も<dialog>を画面全体に広げておき、開閉で背景と中身をフェードさせる */
	.modal {
		position: fixed;
		inset: 0;
		z-index: 999;
		display: grid;
		place-items: center;
		width: 100%;
		max-width: none;
		height: 100%;
		max-height: none;
		background-color: transparent;
		overflow: clip;
		overscroll-behavior: contain;
		pointer-events: none;
		visibility: hidden;
		transition:
			overlay 0.3s allow-discrete,
			visibility 0.3s allow-discrete,
			background-color 0.3s ease-out,
			opacity 0.1s ease-out;

		&::backdrop {
			display: none;
		}

		&[open] {
			pointer-events: auto;
			visibility: visible;
			opacity: 1;
			background-color: oklch(0% 0 0 / 0.4);
			transition:
				visibility 0s allow-discrete,
				background-color 0.3s ease-out,
				opacity 0.1s ease-out;

			& .modal-box {
				opacity: 1;
				scale: 1;
			}
		}
	}

	@starting-style {
		.modal[open] {
			opacity: 0;
		}
	}

	.modal-box {
		position: relative;
		grid-area: 1 / 1;
		width: 91.6667%;
		max-width: 24rem;
		max-height: 100vh;
		padding: 1.5rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		border-radius: var(--radius-box);
		background-color: var(--color-base-100);
		box-shadow: 0 25px 50px -12px oklch(0% 0 0 / 0.25);
		opacity: 0;
		scale: 0.95;
		transition:
			scale 0.3s ease-out,
			opacity 0.2s ease-out 50ms,
			box-shadow 0.3s ease-out;
	}

	.close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
	}

	h3 {
		text-align: center;
	}

	.memo {
		padding-top: 1rem;
		white-space: pre-line;
	}

	.modal-action {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.5rem;
	}

	.publisher {
		border: 0;
		box-shadow: none;
	}

	.modal-backdrop {
		grid-area: 1 / 1;
		place-self: stretch;
		display: grid;
		z-index: -1;
		color: transparent;
	}
</style>
