---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"button">;
---

<button
	type="button"
	class="badge badge-soft badge-primary badge-lg text-small font-bold h-auto px-4 py-1.5 cursor-pointer aria-expanded:bg-primary aria-expanded:border-primary aria-expanded:text-primary-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
	{...Astro.props}
>
	<slot />
</button>
