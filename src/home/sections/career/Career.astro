---
import Section from "../../components/Section.astro";
import { careers } from "./data";
---

<Section id="career" title="経歴">
	{/* 期間・所属を左右に振り分けると狭い画面で窮屈になるため、timeline-compactで全項目を右側に寄せ、
	    snap-iconで丸印を各項目の先頭行に揃える。
	    ただしsnap-iconの--timeline-col-startがcompactの指定を上書きして左列が残るため、liで0に戻す */}
	<ul class="timeline timeline-vertical timeline-compact timeline-snap-icon">
		{careers.map((career, index) => (
			<li class="[--timeline-col-start:0]">
				{index > 0 && <hr class="bg-base-content/10" />}
				<div class="timeline-middle">
					<span class="block size-3 rounded-full bg-primary" aria-hidden="true" />
				</div>
				<div class="timeline-end ms-4 mb-8">
					<p class="text-small text-base-content/70">{career.period}</p>
					<h3 class="text-base font-semibold">{career.organization}</h3>
					<p class="text-base-content/70">{career.role}</p>
					{career.description && <p class="mt-2 text-body">{career.description}</p>}
				</div>
				{index < careers.length - 1 && <hr class="bg-base-content/10" />}
			</li>
		))}
	</ul>
</Section>
