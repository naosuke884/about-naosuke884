---
import SectionHeading from "../../components/section-heading/SectionHeading.astro";

interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="py-8 section-px">
	<div class="max-w-3xl mx-auto">
		<div class="mb-6 flex items-center justify-between">
			<SectionHeading>{title}</SectionHeading>
			<slot name="heading-extra" />
		</div>
		<slot />
	</div>
</section>
