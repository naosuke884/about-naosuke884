---
import CopyLinkButton from "../../components/copy-link/CopyLinkButton.astro";
import SectionHeading from "../../components/section-heading/SectionHeading.astro";

interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section
	id={id}
	class="py-12 section-px"
>
	<div class="max-w-3xl mx-auto">
		<div class="mb-8 flex items-center justify-between">
			<div class="flex items-center gap-2">
				<SectionHeading>{title}</SectionHeading>
				<CopyLinkButton hash={id} label={`${title}セクションへのリンクをコピー`} />
			</div>
			<slot name="heading-extra" />
		</div>
		<slot />
	</div>
</section>
