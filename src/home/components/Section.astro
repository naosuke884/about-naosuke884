---
import SectionHeading from "../../components/section-heading/SectionHeading.astro";

interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
---

<section id={id} class="section-px">
	<div class="content">
		<div class="heading-row">
			<SectionHeading>{title}</SectionHeading>
			<slot name="heading-extra" />
		</div>
		<slot />
	</div>
</section>

<style>
	section {
		padding-block: 2rem;
	}

	.heading-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 1.5rem;
	}
</style>
