---
interface Props {
	href: string;
}

const { href } = Astro.props;
---

<a
	href={href}
	data-nav-dot={href}
	class="group flex items-center gap-2"
>
<span class="block w-3 h-3 md:w-4 md:h-4 rounded-full border border-on-base/30 group-data-[active]:bg-accent group-data-[active]:border-accent hover:bg-accent hover:border-accent transition-colors"></span>
</a>
