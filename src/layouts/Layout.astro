---
import "../styles/global.css";
import Footer from "./Footer.astro";
import NavDot from "./NavDot.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/my-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="pr-12 md:pr-24">
			<slot />
		</div>

		<Footer />

		<nav
			class="fixed right-6 md:right-12 top-1/2 -translate-y-1/2 flex flex-col gap-4 z-50"
		>
			<NavDot href="#about" />
			<NavDot href="#works" />
			<NavDot href="#skills" />
		</nav>

		<script src="./nav-dot-scroll.ts"></script>

		<canvas id="ripple-canvas" class="fixed inset-0 w-full h-full pointer-events-none -z-10"></canvas>
		<script src="./cursor-ripple.ts"></script>
	</body>
</html>
