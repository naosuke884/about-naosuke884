---
import { Font, getImage } from "astro:assets";
import myIcon from "../assets/my-icon.png";
import myIconRound from "../assets/my-icon-round.png";
import "../styles/global.css";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

interface Props {
	title: string;
	description?: string;
	// OG画像のパス(ブログ記事など)。未指定ならサイトアイコンを小さいカードで出す
	ogImage?: string;
}

const { title, description, ogImage } = Astro.props;

// apple-touch-iconは180pxあれば十分なのでビルド時に縮小して使う。
// iOSが自前で角丸マスクをかける(透過は黒塗りされる)ため正方形のまま渡す
const appleTouchIcon = await getImage({
	src: myIcon,
	width: 180,
	height: 180,
	format: "png",
});

// og:imageは絶対URL必須
const ogImageUrl = new URL(ogImage ?? myIconRound.src, Astro.site);
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={myIconRound.src} />
		<link rel="apple-touch-icon" href={appleTouchIcon.src} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="theme-color"
			media="(prefers-color-scheme: light)"
			content="#f8f7f4"
		/>
		<meta
			name="theme-color"
			media="(prefers-color-scheme: dark)"
			content="#151520"
		/>
		<Font cssVariable="--font-inter" preload />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={Astro.url} />
		<meta property="og:site_name" content="about-naosuke884" />
		<meta property="og:type" content={ogImage ? "article" : "website"} />
		<meta property="og:image" content={ogImageUrl} />
		<meta
			name="twitter:card"
			content={ogImage ? "summary_large_image" : "summary"}
		/>
	</head>
	<body class="bg-canvas">
		<a
			href="#main"
			class="btn btn-primary btn-sm fixed top-3 left-3 z-[60] -translate-y-20 shadow-lg focus:translate-y-0"
			>本文へスキップ</a
		>
		<!-- コンテンツ列。幅はコンテンツ幅(max-w-3xl)+左右パディング(md:px-24)の60remで、
		     各セクションの背景帯・区切り線・フッターはこの列の内側に収まる。
		     列の外側はbodyのbg-canvasで一段暗くする -->
		<div class="mx-auto flex min-h-dvh max-w-[60rem] flex-col bg-base-100">
			<Header />

			<main id="main" class="flex-1">
				<slot />
			</main>

			<Footer />
		</div>
	</body>
</html>
