---
const pathname = Astro.url.pathname;

const links = [
	{ href: "/", label: "私について", active: pathname === "/" },
	{ href: "/blog/", label: "ブログ", active: pathname.startsWith("/blog") },
];
---

<header>
	<div class="content inner">
		<a href="/" class="logo">Nao~ <span aria-hidden="true">👋</span></a>
		<nav>
			<ul>
				{
					links.map(({ href, label, active }) => (
						<li>
							<a href={href} aria-current={active ? "page" : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: var(--color-base-100);
		border-bottom: 1px solid var(--color-line);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--header-height);
		padding-inline: 1.5rem;
	}

	.logo {
		font-weight: 700;
		letter-spacing: -0.025em;
		color: var(--color-muted);
		transition: var(--transition-colors);
	}

	/* flexにするとnavの行ボックスから外れ、ピルの縦位置がロゴとずれる */
	ul {
		display: inline-flex;
		gap: 0.25rem;
		font-size: var(--text-nav);
		line-height: var(--text-nav--line-height);
		letter-spacing: var(--text-nav--letter-spacing);
		font-weight: var(--text-nav--font-weight);
	}

	nav a {
		display: block;
		padding: 0.375rem 0.75rem;
		border-radius: var(--radius-field);
		color: var(--color-muted);
		transition-property: color, background-color, box-shadow;
		transition-duration: 0.2s;
		transition-timing-function: cubic-bezier(0, 0, 0.2, 1);

		&:focus-visible {
			outline: 2px solid var(--color-primary);
			outline-offset: 2px;
		}

		&:not([aria-current="page"]):focus-visible {
			background-color: var(--color-line);
		}

		/* アクティブはprimaryのピルで表現する */
		&[aria-current="page"] {
			background-color: var(--color-primary);
			color: var(--color-primary-content);
			box-shadow: 0 2px 3px -2px var(--color-neutral);
		}
	}

	@media (hover: hover) {
		.logo:hover,
		nav a:not([aria-current="page"]):hover {
			color: var(--color-base-content);
		}

		nav a:not([aria-current="page"]):hover {
			background-color: var(--color-line);
		}
	}
</style>
