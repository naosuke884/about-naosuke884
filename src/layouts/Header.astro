---
const pathname = Astro.url.pathname;

const links = [
	{ href: "/", label: "私について", active: pathname === "/" },
	{ href: "/blog/", label: "ブログ", active: pathname.startsWith("/blog") },
];
---

<header class="sticky top-0 z-50 bg-base-100 border-b border-base-content/10">
	<div class="max-w-3xl mx-auto flex items-center justify-between px-6 h-header">
		<a
			href="/"
			class="font-bold tracking-tight text-base-content/70 hover:text-base-content transition-colors"
			>Nao~ <span aria-hidden="true">👋</span></a
		>
		<nav>
			<ul class="menu menu-horizontal gap-1 p-0 text-nav">
				{
					links.map(({ href, label, active }) => (
						<li>
							<a
								href={href}
								class:list={[
									// daisyUIのmenuはfocus-visible時に--tw-outline-styleをnoneにしてoutlineを消すため、
									// outline-solidでスタイルを明示して他の操作要素と同じoutlineを出し直す
									"focus-visible:outline-solid focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
									// menu-activeは背景がneutral由来の黒になり文字色と衝突するため使わず、
									// アクティブはprimaryのピルで表現する
									active
										? "bg-primary text-primary-content"
										: "text-base-content/70 hover:text-base-content",
								]}
								aria-current={active ? "page" : undefined}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
