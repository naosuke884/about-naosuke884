---
import { render } from "astro:content";
import { formatDate, getBlogStaticPaths } from "../../blog/entries";
import CopyLinkButton from "../../components/copy-link/CopyLinkButton.astro";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = getBlogStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, emoji, externalUrl } = entry.data;

const formattedDate = formatDate(date);
---

<Layout
	title={title}
	description={description}
	ogImage={`/blog/${entry.id}/og.png`}
>
	<article class="py-12 section-px">
		<div class="max-w-3xl mx-auto">
			<header class="flex flex-col items-center gap-3 text-center">
				<span class="text-5xl mb-2" aria-hidden="true">{emoji}</span>
				<h1 class="text-heading">{title}</h1>
				<div class="flex items-center gap-2">
					<time datetime={formattedDate} class="text-small text-base-content/70">
						{formattedDate}
					</time>
					<CopyLinkButton label="この記事へのリンクをコピー" />
				</div>
			</header>
			{
				externalUrl && (
					<a
						href={externalUrl}
						target="_blank"
						rel="noopener noreferrer"
						class="card card-border border-base-300 bg-base-200 mt-6 transition-colors hover:border-primary"
					>
						<div class="card-body px-5 py-4 gap-1">
							<span class="text-body font-medium text-base-content">
								{new URL(externalUrl).hostname} で読む ↗
							</span>
							<span class="text-small text-base-content/70 break-all">
								{externalUrl}
							</span>
						</div>
					</a>
				)
			}
			<div class="blog-body mt-8">
				<Content />
			</div>
			<div class="text-center">
				<a href="/blog/" class="link text-small text-base-content/70 mt-12 inline-block"
					>← ブログ一覧へ戻る</a
				>
			</div>
		</div>
	</article>
</Layout>

<!-- Markdown本文の最小スタイリング。<Content />の出力はスコープ対象外なので:global()で当てる。
     文字サイズ・トーンはglobal.cssの@layer base(本文=text-body/70%)に任せ、
     余白とpreflightで消えた装飾だけ復元する -->
<style>
	.blog-body :global(h2) {
		font-size: var(--text-subheading);
		line-height: var(--text-subheading--line-height);
		letter-spacing: var(--text-subheading--letter-spacing);
		font-weight: var(--text-subheading--font-weight);
		margin-block: 2.5rem 0.75rem;
	}

	.blog-body :global(h3) {
		font-weight: 600;
		margin-block: 2rem 0.5rem;
	}

	/* 段落間は行間(line-height 1.8 ≒ 0.8rem)より明確に広くして切れ目を見せる */
	.blog-body :global(p) {
		margin-block: 1.5rem;
	}

	.blog-body :global(ul) {
		list-style: disc;
	}

	.blog-body :global(ol) {
		list-style: decimal;
	}

	.blog-body :global(:is(ul, ol)) {
		padding-inline-start: 2rem;
		margin-block: 1.5rem;
	}

	.blog-body :global(li) {
		margin-block: 0.375rem;
	}

	.blog-body :global(li)::marker {
		color: var(--color-primary);
	}

	.blog-body :global(a) {
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.blog-body :global(code) {
		background: var(--color-base-200);
		border-radius: var(--radius-field);
		padding: 0.125rem 0.375rem;
		font-size: 0.875em;
	}

	.blog-body :global(pre) {
		border-radius: var(--radius-box);
		padding: 1rem;
		overflow-x: auto;
		margin-block: 1rem;
	}

	.blog-body :global(pre code) {
		background: none;
		border-radius: 0;
		padding: 0;
	}

	.blog-body :global(blockquote) {
		border-inline-start: 3px solid var(--color-base-300);
		padding-inline-start: 1rem;
		margin-block: 1rem;
	}

	/* shikiのデュアルテーマ切替(astro.config.mjsのshikiConfig.themesと対) */
	@media (prefers-color-scheme: dark) {
		.blog-body :global(.astro-code),
		.blog-body :global(.astro-code span) {
			color: var(--shiki-dark) !important;
			background-color: var(--shiki-dark-bg) !important;
		}
	}
</style>
