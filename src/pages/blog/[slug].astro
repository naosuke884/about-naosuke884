---
import { render } from "astro:content";
import { formatDate, getBlogStaticPaths } from "../../blog/entries";
import LinkPreviewCard from "../../blog/LinkPreviewCard.astro";
import CopyLinkButton from "../../components/copy-link/CopyLinkButton.astro";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = getBlogStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, date, updated, emoji, externalUrl, toc } =
	entry.data;

// h3は直前のh2の下に入れ子にする。h2より前のh3は親がないので目次に出さない
type TocItem = { slug: string; text: string; children: TocItem[] };
const tocItems: TocItem[] = [];
if (toc) {
	for (const { depth, slug, text } of headings) {
		if (depth === 2) {
			tocItems.push({ slug, text, children: [] });
		} else if (depth === 3) {
			tocItems.at(-1)?.children.push({ slug, text, children: [] });
		}
	}
}

const formattedDate = formatDate(date);
// 公開日と同じ日の更新は出さない
const formattedUpdated =
	updated && formatDate(updated) !== formattedDate
		? formatDate(updated)
		: undefined;
---

<Layout
	title={title}
	description={description}
	ogImage={`/blog/${entry.id}/og.png`}
>
	<article class="section-px">
		<div class="content">
			<header>
				<span class="emoji" aria-hidden="true">{emoji}</span>
				<h1 class="text-heading">{title}</h1>
				<div class="meta">
					<time datetime={formattedDate} class="text-small">
						{formattedDate}
					</time>
					{
						formattedUpdated && (
							<span class="text-small">
								(更新 <time datetime={formattedUpdated}>{formattedUpdated}</time>)
							</span>
						)
					}
					<CopyLinkButton label="この記事へのリンクをコピー" />
				</div>
			</header>
			{externalUrl && <LinkPreviewCard url={externalUrl} />}
			{
				tocItems.length > 0 && (
					<nav class="toc" aria-labelledby="toc-title">
						<p id="toc-title" class="toc-title">
							目次
						</p>
						<ol>
							{tocItems.map((item) => (
								<li>
									<a href={`#${item.slug}`}>{item.text}</a>
									{item.children.length > 0 && (
										<ol>
											{item.children.map((child) => (
												<li>
													<a href={`#${child.slug}`}>{child.text}</a>
												</li>
											))}
										</ol>
									)}
								</li>
							))}
						</ol>
					</nav>
				)
			}
			<div class="blog-body">
				<Content />
			</div>
			<div class="back">
				<a href="/blog/" class="link text-small">← ブログ一覧へ戻る</a>
			</div>
		</div>
	</article>
</Layout>

<!-- Markdown本文の最小スタイリング。<Content />の出力はスコープ対象外なので:global()で当てる。
     文字サイズ・トーンはglobal.cssの@layer base(本文=--text-body/70%)に任せ、
     余白とリセットで消えた装飾だけ復元する -->
<style>
	article {
		padding-block: 3rem;
	}

	header {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.emoji {
		margin-bottom: 0.5rem;
		font-size: 3rem;
		line-height: 1;
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	time {
		font-variant-numeric: tabular-nums;
	}

	.back {
		text-align: center;
	}

	.back a {
		display: inline-block;
		margin-top: 3rem;
	}

	.toc {
		margin-top: 2rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--color-base-300);
		border-radius: var(--radius-field);
		font-size: var(--text-small);
		line-height: var(--text-small--line-height);
	}

	.toc-title {
		font-weight: 600;
		color: var(--color-base-content);
	}

	.toc ol {
		list-style: decimal;
		padding-inline-start: 1.5rem;
		margin-top: 0.5rem;
	}

	.toc li::marker {
		color: var(--color-primary);
	}

	.toc a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--color-base-300);
		text-underline-offset: 0.2em;

		&:hover {
			color: var(--color-primary);
		}

		&:focus-visible {
			outline: 2px solid;
			outline-offset: 2px;
		}
	}

	/* 長いURLや英単語がモバイルで横スクロールを生まないよう折り返す */
	.blog-body {
		margin-top: 2rem;
		overflow-wrap: anywhere;
	}

	.blog-body :global(h2) {
		font-size: var(--text-subheading);
		line-height: var(--text-subheading--line-height);
		letter-spacing: var(--text-subheading--letter-spacing);
		font-weight: var(--text-subheading--font-weight);
		margin-block: 2.5rem 0.75rem;
	}

	.blog-body :global(h3) {
		font-weight: 600;
		margin-block: 2rem 0.5rem;
	}

	/* 段落間は行間(line-height 1.8 ≒ 0.8rem)より明確に広くして切れ目を見せる */
	.blog-body :global(p) {
		margin-block: 1.5rem;
	}

	.blog-body :global(ul) {
		list-style: disc;
	}

	.blog-body :global(ol) {
		list-style: decimal;
	}

	.blog-body :global(:is(ul, ol)) {
		padding-inline-start: 2rem;
		margin-block: 1.5rem;
	}

	.blog-body :global(li) {
		margin-block: 0.375rem;
	}

	.blog-body :global(li)::marker {
		color: var(--color-primary);
	}

	.blog-body :global(a) {
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* 日本語のシステムフォントでは太さだけだと差が出にくいため、蛍光ペン風のマーカーを引く。
	   文字色をフルトーンにすると見出しと紛れ、primary色にするとリンクと紛れるので色は変えない。
	   輪郭はSVG画像だとテーマ色(CSS変数)を参照できないため、不揃いなborder-radiusで手描きの縁を出し、
	   書き始めと書き終わりのインク溜まりをグラデーションで重ねる */
	.blog-body :global(strong) {
		--marker: color-mix(in oklch, var(--color-primary) 22%, transparent);
		--marker-ink: color-mix(in oklch, var(--color-primary) 14%, transparent);
		background-color: var(--marker);
		background-image: linear-gradient(
			100deg,
			var(--marker-ink),
			transparent 0.6em,
			transparent calc(100% - 0.6em),
			var(--marker-ink)
		);
		border-radius: 0.3em 0.8em 0.4em 0.9em / 0.7em 0.3em 0.8em 0.4em;
		padding: 0.05em 0.2em;
		/* 折り返したときも行ごとに縁を付ける */
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
	}

	.blog-body :global(code) {
		background: var(--color-base-200);
		border-radius: var(--radius-field);
		padding: 0.125rem 0.375rem;
		font-size: 0.875em;
	}

	.blog-body :global(pre) {
		border-radius: var(--radius-box);
		padding: 1rem;
		overflow-x: auto;
		margin-block: 1rem;
	}

	.blog-body :global(pre code) {
		background: none;
		border-radius: 0;
		padding: 0;
	}

	.blog-body :global(blockquote) {
		border-inline-start: 3px solid var(--color-base-300);
		padding-inline-start: 1rem;
		margin-block: 1rem;
	}

	/* 表はsrc/blog/markdown-tables.tsでdiv.table-scrollに包まれる。
	   tableを直接スクロールさせると、スクロール容器と中身を兼ねて列の少ない表が本文幅に広がらないため、
	   スクロールはdivに任せる */
	.blog-body :global(.table-scroll) {
		--scroll-cover: var(--color-base-100);
		--scroll-shadow: color-mix(in oklch, var(--color-base-content) 15%, transparent);
		overflow-x: auto;
		margin-block: 1.5rem;
		/* スクロールバーが常時表示されない環境でも続きがあると分かるよう、隠れている側の端に影を出す。
		   localの覆いが中身と一緒に動き、端まで来ると固定(scroll)の影を隠す。JSでスクロール位置を監視せずに済む */
		background:
			linear-gradient(to right, var(--scroll-cover) 30%, transparent) left / 2rem 100%,
			linear-gradient(to left, var(--scroll-cover) 30%, transparent) right / 2rem 100%,
			linear-gradient(to right, var(--scroll-shadow), transparent) left / 0.75rem 100%,
			linear-gradient(to left, var(--scroll-shadow), transparent) right / 0.75rem 100%;
		background-repeat: no-repeat;
		background-attachment: local, local, scroll, scroll;
	}

	.blog-body :global(table) {
		min-width: 100%;
		font-size: var(--text-small);
		line-height: var(--text-small--line-height);
		border-collapse: collapse;
	}

	/* ラベルの列は折り返さず中身の幅に詰める */
	.blog-body :global(:is(th, td)) {
		white-space: nowrap;
		border: 1px solid var(--color-base-300);
		padding: 0.5rem 0.75rem;
		text-align: start;
		vertical-align: top;
	}

	/* 文章の列(markdown-tables.tsが文字数で判定)は折り返し、下限を持たせる。
	   .blog-bodyのoverflow-wrap: anywhereのままだと最小幅が1文字になって潰れるため通常に戻す。
	   下限はtext-embedding-3-largeのような長いモデル名より広くし、英単語の途中で折り返さないようにする */
	.blog-body :global(.table-wide) {
		white-space: normal;
		overflow-wrap: break-word;
		min-width: 14em;
	}

	/* 不透明な背景だと.table-scrollのスクロールの影を覆い隠すため、半透明の色を重ねてbase-200相当に見せる */
	.blog-body :global(th) {
		background: color-mix(in srgb, var(--color-base-content) 6%, transparent);
		color: var(--color-base-content);
		font-weight: 600;
	}

	/* shikiのデュアルテーマ切替(astro.config.mjsのshikiConfig.themesと対) */
	@media (prefers-color-scheme: dark) {
		.blog-body :global(.astro-code),
		.blog-body :global(.astro-code span) {
			color: var(--shiki-dark) !important;
			background-color: var(--shiki-dark-bg) !important;
		}
	}
</style>
