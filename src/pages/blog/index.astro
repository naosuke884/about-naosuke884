---
import { getCollection } from "astro:content";
import { formatDate } from "../../blog/entries";
import SectionHeading from "../../components/section-heading/SectionHeading.astro";
import Layout from "../../layouts/Layout.astro";

const entries = (await getCollection("blog")).toSorted(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="ブログ" description="Hayashi Naokiのブログ">
	<section class="section-px">
		<div class="content">
			<div class="heading">
				<SectionHeading level={1}>ブログ</SectionHeading>
			</div>
			<ul class="row-list">
				{
					entries.map((entry) => (
						<li>
							<span class="emoji" aria-hidden="true">
								{entry.data.emoji}
							</span>
							<div class="text">
								<time datetime={formatDate(entry.data.date)} class="text-small">
									{formatDate(entry.data.date)}
								</time>
								{/* liをaにはできないため、リンクの::afterを行全体に広げてクリック領域にする */}
								<a href={`/blog/${entry.id}/`} class="row-link">
									<span class="title">{entry.data.title}</span>
								</a>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>

<style>
	section {
		padding-block: 3rem;
	}

	.heading {
		margin-bottom: 2rem;
	}

	/* hover背景が見出しの左端より外に出るよう、行の左右パディング分だけ広げる */
	ul {
		margin-inline: -1rem;
		font-size: 0.875rem;
	}

	.emoji {
		align-self: center;
		font-size: 1.875rem;
		line-height: calc(2.25 / 1.875);
	}

	.text {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	time {
		font-variant-numeric: tabular-nums;
	}

	.title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
</style>
