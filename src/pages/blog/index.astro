---
import { getCollection } from "astro:content";
import { formatDate } from "../../blog/entries";
import SectionHeading from "../../components/section-heading/SectionHeading.astro";
import Layout from "../../layouts/Layout.astro";

const entries = (await getCollection("blog")).toSorted(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="ブログ" description="Hayashi Naokiのブログ">
	<section class="py-12 section-px">
		<div class="max-w-3xl mx-auto">
			<SectionHeading level={1} class="mb-8">ブログ</SectionHeading>
			<ul class="list">
				{
					entries.map((entry) => (
						<li class="list-row px-0">
							<span class="text-3xl self-center" aria-hidden="true">
								{entry.data.emoji}
							</span>
							<div class="list-col-grow flex flex-col gap-2">
								<a
									href={`/blog/${entry.id}/`}
									class="text-subheading text-base-content hover:text-primary transition-colors"
								>
									{entry.data.title}
								</a>
								<time
									datetime={formatDate(entry.data.date)}
									class="text-small text-base-content/70"
								>
									{formatDate(entry.data.date)}
								</time>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
