---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const entries = (await getCollection("blog")).toSorted(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---

<Layout title="ブログ | about-naosuke884" description="naosuke884のブログ">
	<section class="py-12 px-12 md:px-24">
		<div class="max-w-3xl mx-auto">
			<h1 class="text-heading mb-8 flex items-center gap-3">
				<span class="w-1 self-stretch rounded-full bg-primary" aria-hidden="true"
				></span>
				ブログ
			</h1>
			<ul class="list">
				{
					entries.map((entry) => (
						<li class="list-row px-0">
							<span class="text-3xl self-center" aria-hidden="true">
								{entry.data.emoji}
							</span>
							<div class="list-col-grow flex flex-col gap-2">
								<a
									href={`/blog/${entry.id}/`}
									class="text-subheading text-base-content hover:text-primary transition-colors"
								>
									{entry.data.title}
								</a>
								<time
									datetime={formatDate(entry.data.date)}
									class="text-small text-base-content/70"
								>
									{formatDate(entry.data.date)}
								</time>
							</div>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
